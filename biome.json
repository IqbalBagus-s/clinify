{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!!**/dist", "!!**/coverage", "!!**/src/generated"]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "space",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "useImportType": "off" },
			"complexity": { "noStaticOnlyClass": "off" }
		}
	},
	"javascript": {
		"parser": { "unsafeParameterDecoratorsEnabled": true },
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "off" } }
	}
}